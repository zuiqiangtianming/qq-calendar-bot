[Unit]
Description=QQ 群日历管家（1023 群管家）
Documentation=see README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__
ExecStart=__ROOT__/.venv/bin/python __ROOT__/bot.py
Restart=always
RestartSec=5
StandardOutput=append:__ROOT__/bot.log
StandardError=append:__ROOT__/bot.log

[Install]
WantedBy=multi-user.target
